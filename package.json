{
  "name": "pluma",
  "version": "1.0.0",
  "description": "An AI-assisted writing app for writers, like VS Code for writing.",
  "main": "./out/main/index.js",
  "author": "jcamatta",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "type-coverage": "type-coverage --strict --at-least 95",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:preload && npm run typecheck:web && npm run typecheck:e2e",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.55",
    "@ag-ui/core": "^0.0.55",
    "@anthropic-ai/claude-agent-sdk": "^0.3.165",
    "@base-ui/react": "^1.5.0",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.107.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@parcel/watcher": "^2.5.6",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-blockquote": "^3.26.0",
    "@tiptap/extension-bold": "^3.26.0",
    "@tiptap/extension-code": "^3.26.0",
    "@tiptap/extension-code-block": "^3.26.0",
    "@tiptap/extension-document": "^3.26.0",
    "@tiptap/extension-dropcursor": "^3.26.0",
    "@tiptap/extension-gapcursor": "^3.26.0",
    "@tiptap/extension-hard-break": "^3.26.0",
    "@tiptap/extension-heading": "^3.26.0",
    "@tiptap/extension-horizontal-rule": "^3.26.0",
    "@tiptap/extension-italic": "^3.26.0",
    "@tiptap/extension-list": "^3.26.0",
    "@tiptap/extension-paragraph": "^3.26.0",
    "@tiptap/extension-strike": "^3.26.0",
    "@tiptap/extension-text": "^3.26.0",
    "@tiptap/extension-typography": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/extensions": "^3.26.0",
    "@tiptap/markdown": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "effect": "^3.21.3",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@jcamatta/veto": "^0.1.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.8"
  }
}
