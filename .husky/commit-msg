msg_file="$1"
msg="$(head -n 1 "$msg_file" | tr -d '\r')"

# Never commit on a trunk branch, and only from a branch that follows
# Conventional Branch (https://conventionalbranch.org). Every plan and every
# change lives on its own branch.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
branch_pattern='^(feat|fix|hotfix|release|chore)/[a-z0-9]+(\.[a-z0-9]+)*(-[a-z0-9]+(\.[a-z0-9]+)*)*$'

case "$branch" in
  main|master|develop|HEAD)
    echo "Refusing to commit on '$branch'."
    echo "Create a branch first — every change goes on its own branch."
    echo "Use a Conventional Branch name: feat/<desc>, fix/<desc>, chore/<desc>, etc."
    exit 1
    ;;
esac

if ! printf '%s' "$branch" | grep -Eq "$branch_pattern"; then
  echo "Branch '$branch' is not a valid Conventional Branch name."
  echo "Expected: <type>/<description> — type one of feat|fix|hotfix|release|chore"
  echo "Description: lowercase letters, digits, hyphen-separated (dots only for release versions)."
  echo "Examples: feat/chat-panel, fix/null-response, release/1.2.0"
  exit 1
fi

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9-]*\))?(!)?: .{1,100}$'

if ! printf '%s' "$msg" | grep -Eq "$pattern"; then
  echo "Invalid commit message."
  echo "Expected: type(scope): description"
  echo "Examples: feat(ui): add sidebar, fix: handle null response, refactor(api)!: simplify client"
  echo "Rules: use a Conventional Commit type, optional scope, optional !, and a 1-100 character description."
  exit 1
fi

# No authored/attribution footers — the message is the change, not who or what wrote it.
forbidden='co-authored-by|signed-off-by|generated with|co-written-by|assisted-by'
if grep -Eiq "$forbidden" "$msg_file"; then
  echo "Forbidden trailer in commit message."
  echo "Remove Co-authored-by / Signed-off-by / 'Generated with' / similar attribution footers."
  exit 1
fi
