{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "NonEmptyTrimmedString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
      "minLength": 1
    },
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    },
    "Positive": {
      "type": "number",
      "description": "a positive number",
      "title": "positive",
      "exclusiveMinimum": 0
    }
  },
  "type": "object",
  "required": ["name", "mode", "paths", "systemPrompt", "rules"],
  "properties": {
    "name": {
      "$ref": "#/$defs/NonEmptyTrimmedString"
    },
    "mode": {
      "type": "string",
      "enum": ["static", "runtime"]
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/NonEmptyTrimmedString"
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyTrimmedString"
      }
    },
    "systemPrompt": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/NonEmptyString"
          },
          {
            "anyOf": [
              {
                "type": "object",
                "required": ["id", "instruction"],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "a string at most 64 character(s) long",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "title": "maxLength(64)",
                    "maxLength": 64
                  },
                  "instruction": {
                    "$ref": "#/$defs/NonEmptyString"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/NonEmptyTrimmedString"
                    }
                  },
                  "ignore": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/NonEmptyTrimmedString"
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["id", "rule"],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "a string at most 64 character(s) long",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "title": "maxLength(64)",
                    "maxLength": 64
                  },
                  "rule": {
                    "$ref": "#/$defs/NonEmptyString"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/NonEmptyTrimmedString"
                    }
                  },
                  "ignore": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/NonEmptyTrimmedString"
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    },
    "model": {
      "$ref": "#/$defs/NonEmptyTrimmedString"
    },
    "effort": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh", "max"]
    },
    "maxTurns": {
      "$ref": "#/$defs/Positive",
      "description": "an integer",
      "title": "int",
      "type": "integer"
    },
    "timeoutMs": {
      "$ref": "#/$defs/Positive",
      "description": "an integer",
      "title": "int",
      "type": "integer"
    },
    "maxDiffLines": {
      "$ref": "#/$defs/Positive",
      "description": "an integer",
      "title": "int",
      "type": "integer"
    },
    "maxDiffFiles": {
      "$ref": "#/$defs/Positive",
      "description": "an integer",
      "title": "int",
      "type": "integer"
    },
    "maxCostUsd": {
      "$ref": "#/$defs/Positive"
    }
  },
  "additionalProperties": false
}
